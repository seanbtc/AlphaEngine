# AlphaEngine 环境变量样例（部署侧写入服务器 .env；勿提交真实值）
# 说明：钉钉凭证优先级 = 服务专属 > 共享（缺失自动回退；全部缺失时通知禁用并告警）

# —— 钉钉（通知/告警）——
ALPHAENGINE_DINGTALK_WEBHOOK=
ALPHAENGINE_DINGTALK_SECRET=
DINGTALK_WEBHOOK=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# —— Promo 事件服务（发帖推送；推送失败即丢弃）——
PROMO_EVENTS_URL=
PROMO_EVENTS_TOKEN=

# —— AI 服务地址覆盖（默认取 config.json 的 ai_service.endpoint）——
AISERVICE_URL=
