{
  "_note": "Glassnode Alpha Engine 配置文件",

  "deepseek": {
    "api_key": "sk-94974e3dbd1e4f5d9b9a733a79900b0e",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.3,
    "max_tokens": 16384,
    "timeout_seconds": 120,
    "max_input_chars": 30000,
    "_note_vision": "推文夹带图片时切换视觉模型读取图片; vision_enabled=false 则只用文本。引用外链页面抓取由 max_links_per_tweet 控制",
    "vision_enabled": true,
    "vision_model": "deepseek-v4-flash-vision-exp",
    "max_images_per_request": 6,
    "max_links_per_tweet": 2,
    "link_timeout_seconds": 15,
    "link_max_chars": 1500,
    "filter_non_btc": true
  },

  "fetcher": {
    "username": "glassnode",
    "usernames": ["glassnode", "cryptovizart", "n3ocortex"],
    "max_tweets_per_fetch": 20,
    "max_tweet_age_days": 30,
    "timeout_seconds": 20,
    "retweet_whitelist": ["cryptovizart","n3ocortex"],
    "_note_web": "web_fallback: x.com 不可达时解析 web/ 目录保存的 X 主页 HTML; web_dir 为网页目录 (相对项目根)",
    "web_fallback": true,
    "web_dir": "web"
  },

  "alpha": {
    "smoothing": {
      "_note": "基于BTC 4年周期的alpha推进规则: min_daily_step=每日最小推进(无推文时也推进), max_change_per_step=每日最大推进上限. 动态步长=1/当前regime预期天数, 但不低于min_daily_step.",
      "max_change_per_step": 0.05,
      "min_daily_step": 0.015,
      "cooldown_cycles_after_regime_change": 10,
      "min_cycles_for_extreme_alpha": 20
    },
    "evidence": {
      "min_categories_for_regime_change": 3,
      "min_total_score_for_regime_change": 2.0,
      "high_conf_min_categories": 2,
      "high_conf_min_total": 1.5,
      "decay_per_cycle": 0.01,
      "stability_window": 5
    },
    "confidence_gate": {
      "low_confidence_blocks_regime_change": true,
      "low_confidence_max_alpha_abs": 0.3
    },
    "regime_alpha_map": {
      "_note": "确认制: 确认改变方向, 多次确认逐步积累仓位。中性(=0)是清仓翻转点, 不直接跳满仓。",
      "BEAR_BOTTOM": 0.00,
      "RECOVERY": 0.70,
      "BULL": 1.00,
      "DEEP_BULL": 0.30,
      "BULL_COOLING": 0.00,
      "BEAR": -1.00,
      "BEAR_DEEP": -0.30
    }
  },

  "knowledge": {
    "distill": {
      "schedule_day": "sunday",
      "schedule_hour_utc": 0,
      "memory_compress_threshold_chars": 10000,
      "max_prediction_age_days": 30
    },
    "drift": {
      "new_term_trigger_count": 5,
      "deprecated_term_trigger_count": 10,
      "quality_drop_trigger": 5,
      "quality_drop_persistence": 3,
      "auto_calibrate_new_terms": true,
      "auto_calibrate_thresholds": false,
      "require_confirm_regime_change": true,
      "require_confirm_threshold_change": true
    }
  },

  "tradesync": {
    "_note": "交易指令输出配置。可以是 HTTP endpoint 或文件路径。",
    "enabled": false,
    "mode": "file",
    "output_dir": "orders",
    "http_endpoint": "",
    "api_key": "",
    "_output_format": "JSONL with {timestamp, alpha, direction, size_pct, limit, stop}"
  },

  "datafeed": {
    "_note": "BTC 价格数据来源。通过 DataFeed 接口获取。",
    "enabled": true,
    "mode": "http",
    "endpoint": "https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT",
    "symbol": "BTC/USDT",
    "timeout_seconds": 10
  },

  "paths": {
    "data_dir": "data",
    "state_file": "state.json"
  },

  "schedule": {
    "_note": "daily_time: 运行时间 (北京时间, 如 12:25)。weekdays: 仅在指定星期运行, 0=周一,1=周二,2=周三,3=周四,4=周五,5=周六,6=周日, 留空=每天。min_analysis_interval_hours: 距上次成功 DeepSeek 分析不足该小时数则跳过抓取/分析 (0=禁用)",
    "daily_time": "12:25",
    "weekdays": [1, 3],
    "poll_interval_seconds": 86400,
    "min_analysis_interval_hours": 24,
    "retry_on_fetch_failure": true,
    "retry_delay_seconds": 120
  },

  "review": {
    "_note": "月度复盘: 每月最后一天 20:00(UTC) 触发, min_cycles_before_review=最少分析次数才触发复盘",
    "min_cycles_before_review": 20
  },

  "dingtalk": {
    "enabled": true,
    "webhook_url": "https://oapi.dingtalk.com/robot/send?access_token=63e160c26acc3dfe3e55be8a86f1a8aa5af3fc8f17b839b7de1af2a2a7b12af8",
    "secret": "",
    "_note": "钉钉机器人推送。secret 为加签密钥(可选)。"
  },

  "promo": {
    "_note": "分析帖子输出给 Promo 发帖项目。posts_file 为 JSONL 桥文件 (相对项目根目录)。",
    "enabled": true,
    "posts_file": "../Promo/runtime/alphaengine_posts.jsonl"
  },

  "backfill": {
    "_note": "首次启动回溯历史数据。bulk_fetch_limit 控制 snscrape 抓取上限。max_analysis_samples 控制分析采样数。",
    "enabled": true,
    "batch_size": 5,
    "bulk_fetch_limit": 2000,
    "max_analysis_samples": 200,
    "max_total_tweets": 50
  }
}
